# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
build/
.turbo/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# env and secrets: never commit real keys
.env
.env.*
!.env.example

# data and models: large files stay out of git
/data/
eval/data/
models/**/checkpoints/
models/**/*.onnx
models/**/*.pt
*.mp4
# ...except the small site clips committed by the site-clips workflow (under 12 MB in total)
!apps/web/public/media/clips/*.mp4
*.mov

# os / editors
.DS_Store
.idea/
.vscode/
*.log

# supabase local
supabase/.temp/
supabase/.branches/
