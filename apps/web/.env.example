# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin for links and Open Graph. A bare host gets https:// added; invalid values fall back.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 0 to hide "Continue with Google" (e.g. until the provider is enabled in Supabase Auth).
NEXT_PUBLIC_AUTH_GOOGLE=1

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local only: serve the dashboard from seeded in-memory data instead of Supabase.
# Refused when VERCEL_ENV=production. Sign in as demo@ormes.dev / ormes-demo.
QUELLIX_DEMO=
# Optional, with QUELLIX_DEMO: a local .webm/.mp4 played in Review (pnpm e2e generates one).
QUELLIX_DEMO_VIDEO=
