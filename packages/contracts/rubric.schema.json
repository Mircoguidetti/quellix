{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quellix.ai/schemas/rubric.schema.json",
  "title": "Rubric",
  "description": "A collector's acceptance spec for one task, usually copied from the lab's spec. Checks produce measurements; the rubric turns measurements into pass / fail / uncertain. A failed critical check rejects; a failed non-critical check, or an uncertain critical one, sends the video to review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "task", "checks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "library_id": {
          "type": "string",
          "description": "Id of a task in the Quellix task library (e.g. 'load_dishwasher'). When absent, task completion falls back to a general model."
        },
        "description": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "items": { "type": "string" } },
        "final_state": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_completed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "critical": { "type": "boolean", "default": true },
            "min_confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 }
          }
        },
        "hands_visible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "critical": { "type": "boolean", "default": true },
            "scope": { "enum": ["manipulation", "whole_video"], "default": "manipulation" },
            "require_both": { "type": "boolean", "default": true },
            "min_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
          }
        },
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "critical": { "type": "boolean", "default": false },
            "max_off_target_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
            "max_unstable_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 }
          }
        },
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "critical": { "type": "boolean", "default": true },
            "min_duration_s": { "type": "number", "minimum": 0 },
            "max_duration_s": { "type": "number", "minimum": 0 },
            "min_width": { "type": "integer", "minimum": 1 },
            "min_height": { "type": "integer", "minimum": 1 },
            "min_fps": { "type": "number", "minimum": 1 },
            "max_blur_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 },
            "max_bad_exposure_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "faces": { "enum": ["reject", "review", "ignore"], "default": "review" },
            "documents": { "enum": ["reject", "review", "ignore"], "default": "review" },
            "screens": { "enum": ["reject", "review", "ignore"], "default": "review" }
          }
        },
        "originality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "similarity_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
            "on_duplicate": { "enum": ["reject", "review"], "default": "reject" }
          }
        }
      }
    }
  }
}
