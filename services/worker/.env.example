SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: general-model baseline for task_completed (only used when allowed)
QUELLIX_ALLOW_EXTERNAL_MODELS=0
GEMINI_API_KEY=
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=
# Optional: local paths for model weights and contracts
QUELLIX_YUNET_PATH=
QUELLIX_MODEL_DIR=
QUELLIX_CONTRACTS_DIR=
# Global kill switch for sending video to Gemini/TwelveLabs; the org must also allow it
# (organizations.allow_external_models). Both must be true.
# Price per second of the Modal GPU in use (modal.com/pricing); unset -> GPU cost counts as 0
QUELLIX_GPU_USD_PER_SECOND=
# 1 = compute DINOv2 ViT-S/14 embeddings (needs the `embed` extra); weights from Hugging Face
QUELLIX_USE_DINOV2=0
QUELLIX_DINOV2_PATH=
