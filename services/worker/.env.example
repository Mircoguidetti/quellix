# Modal secret `quellix-supabase` holds these two (and may hold the optional ones below).
# The same two names are GitHub repository secrets for the post-deploy smoke test.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: general-model baseline for task_completed (only used when allowed)
QUELLIX_ALLOW_EXTERNAL_MODELS=0
GEMINI_API_KEY=
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=
# Optional: local paths for model weights and contracts
QUELLIX_YUNET_PATH=
QUELLIX_MODEL_DIR=
QUELLIX_CONTRACTS_DIR=
# Global kill switch for sending video to Gemini/TwelveLabs; the org must also allow it
# (organizations.allow_external_models). Both must be true.
# Price of one second of the worker's compute, from modal.com/pricing: CPU cores x core price
# + GiB x memory price (2 cores, 4 GiB by default), or the GPU price. Unset -> compute counts
# as 0 and jobs.cost_usd holds only API spend.
QUELLIX_COMPUTE_USD_PER_SECOND=
# Deploy-time (GitHub repository variable, not a secret): GPU type, e.g. T4. Empty = CPU only.
# A GPU also installs torch/transformers and turns on the DINOv2 embedder.
QUELLIX_WORKER_GPU=
# 1 = compute DINOv2 ViT-S/14 embeddings (needs the `embed` extra); weights from Hugging Face
QUELLIX_USE_DINOV2=0
QUELLIX_DINOV2_PATH=
